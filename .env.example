# Copy this file to .env and fill in real values.
# .env is git-ignored; this file is committed and must never contain secrets.

# ----------------------------------------------------------------------------
# Database (Neon / PostgreSQL)  -- REQUIRED
# ----------------------------------------------------------------------------
# Neon dashboard -> your project -> Connect -> copy the "Pooled connection"
# string and make sure it starts with postgresql:// (not postgres://).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------------------------
# Frontend / CORS
# ----------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API. Wildcards
# are not allowed here because credentials are enabled.
CORS_ORIGINS=http://localhost:3000

# Page that password reset emails link to. The token is appended as
# ?token=<uuid>. Defaults to the reset page this API serves itself at
# /auth/reset-password, so the flow works without a frontend. Point it at your
# own page (e.g. https://yourapp.com/reset-password) once you have one.
PASSWORD_RESET_URL=http://localhost:8000/auth/reset-password

# ----------------------------------------------------------------------------
# JWT  -- REQUIRED
# ----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
# Keep short — logout revokes refresh only; this is the post-logout access window.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# How long a refresh token stays valid. Refresh tokens are rotated on every
# use, so this is the maximum idle time before a user must log in again.
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----------------------------------------------------------------------------
# Payload encryption  -- REQUIRED
# ----------------------------------------------------------------------------
# Used to encrypt user IDs handed to clients. Must be a valid Fernet key and
# must stay the same across restarts and worker processes.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Email / SMTP  -- required for email OTPs and password reset
# ----------------------------------------------------------------------------
# For Gmail, SMTP_PASSWORD must be a 16-character App Password, not your
# account password (requires 2FA enabled on the Google account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Shown in email footers (OTP + password reset).
COMPANY_NAME=Your Company Name

# ----------------------------------------------------------------------------
# Google OAuth  -- required for "Login with Google"
# ----------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ----------------------------------------------------------------------------
# AWS SNS  -- required only for SMS/phone OTPs
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
